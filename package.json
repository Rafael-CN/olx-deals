{
  "name": "garimpo-olx",
  "version": "1.0.11",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "garimpo": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "README.md",
    "LICENSE",
    "skill/**/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "garimpo": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "ci": "npm run format:check && npm run lint && npm run type-check && npm run test && npm run build",
    "postinstall": "playwright install chromium || echo 'Run: npx playwright install chromium'"
  },
  "keywords": [
    "olx",
    "olx-brasil",
    "scraper",
    "cli",
    "playwright",
    "classifieds",
    "marketplace",
    "brazil",
    "claude-skill"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Łukasz Margiela",
  "license": "MIT",
  "description": "CLI for bulk collection and triage of olx.com.br classified ads: adaptive sharding past the 5.000-result ceiling, configurable triage stages, and bargain detection against a product's own median price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-margiela/olx-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/l-margiela/olx-mcp/issues"
  },
  "homepage": "https://github.com/l-margiela/olx-mcp#readme",
  "dependencies": {
    "playwright": "^1.55.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
